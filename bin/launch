#!/usr/bin/env bash

qemu-system-x86_64 \
  -enable-kvm                                                    \
  -m 4G                                                          \
  -smp 2                                                         \
  -hda ../output-replicant/replicant                             \
  -boot d                                                        \
  -netdev user,id=net0,net=192.168.0.0/24,dhcpstart=192.168.0.9  \
  -device virtio-net-pci,netdev=net0                             \
  -vga qxl                                                       \
  -monitor unix:/tmp/replicant-monitor.sock,server=on,wait=off   \
  -device AC97
