#!/usr/bin/env bash

qemu-system-x86_64 \
  -enable-kvm                                                    \
  -m 4G                                                          \
  -smp 2                                                         \
  -hda ../output-replicant/replicant                             \
  -boot d                                                        \
  -netdev user,id=net0,hostfwd=tcp:127.0.0.1:2222-:22            \
  -device virtio-net-pci,netdev=net0
  -vga qxl                                                       \
  -monitor unix:/tmp/replicant-monitor.sock,server=on,wait=off
